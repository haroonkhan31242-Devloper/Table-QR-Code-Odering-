# TableCraft — demo configuration
#
# Copy this file to `.env` and choose your own values, then restart `npm run dev`.
#
# SECURITY WARNING: every VITE_* variable is bundled into the browser JavaScript.
# These values are NOT secret and provide demo-only, frontend-only sign-in.
# Replace the demo auth service (src/services/authentication) with Firebase
# Authentication or a backend before any real deployment.

# Super Admin portal (/admin/login)
VITE_DEMO_SUPER_ADMIN_USERNAME=admin
VITE_DEMO_SUPER_ADMIN_PASSWORD=change-me

# Restaurant portal (/portal/login) — owner account of the first demo restaurant
VITE_DEMO_RESTAURANT_USERNAME=manager
VITE_DEMO_RESTAURANT_PASSWORD=change-me

# Optional: password for the other seeded demo staff (waiters, kitchen, cashier,
# other restaurants' owners). Falls back to VITE_DEMO_RESTAURANT_PASSWORD.
VITE_DEMO_STAFF_PASSWORD=change-me

# Restaurant demo passwords are hashed into browser storage when demo data is
# first created. After changing them, use Super Admin → Data & system → Reset demo data.
